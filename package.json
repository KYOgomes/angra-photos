{
  "name": "album-ilha-grande",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "dev:api:remote": "wrangler dev --port 8787 --remote",
    "build": "tsc -b && vite build && vite build -c vite.sw.config.ts",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply album-db --local",
    "db:migrate": "wrangler d1 migrations apply album-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.1",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "hash-wasm": "^4.12.0",
    "heic2any": "^0.0.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
